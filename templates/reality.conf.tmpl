# ====== vps-relay managed: DO NOT HAND EDIT ======
# relay-meta: {{.MetaJSON}}
# =================================================

server {
    listen 80;
    listen [::]:80;
    server_name {{.Domain}};
    return 301 https://$host$request_uri;
}
{{if .SNI443}}
server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    server_name {{.Domain}};

    ssl_certificate     /usr/local/nginx/conf/ssl/{{.Domain}}/fullchain.pem;
    ssl_certificate_key /usr/local/nginx/conf/ssl/{{.Domain}}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/local/nginx/html/relay-camouflage;
    index index.html;
    location / {
        try_files $uri $uri/ =404;
    }
}
{{end -}}
